+
+// 汇总当前选中音视频流的压缩输入码率，单位为 bit/s
+uint64_t cardbili_source_bitrate(void)
+{
+    uint64_t total = 0;
+    for (InputStream *ist = ist_iter(NULL); ist; ist = ist_iter(ist)) {
+        DemuxStream *ds = ds_from_ist(ist);
+        uint64_t bitrate;
+        if (ds->discard || (ist->par->codec_type != AVMEDIA_TYPE_VIDEO &&
+                            ist->par->codec_type != AVMEDIA_TYPE_AUDIO))
+            continue;
+        bitrate = atomic_load_explicit(&ds->cardbili_bitrate, memory_order_relaxed);
+        if (!bitrate)
+            return 0;
+        total += bitrate;
+    }
+    return total;
 }
 
