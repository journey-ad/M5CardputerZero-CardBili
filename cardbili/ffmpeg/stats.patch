+        ist->par->codec_type == AVMEDIA_TYPE_AUDIO) {
+        int64_t duration;
+        if (!ds->cardbili_bitrate_bytes || ds->dts < ds->cardbili_bitrate_start) {
+            ds->cardbili_bitrate_start = ds->dts;
+            ds->cardbili_bitrate_bytes = 0;
+        }
+        ds->cardbili_bitrate_bytes += pkt->size;
+        duration = ds->next_dts - ds->cardbili_bitrate_start;
+        if (duration >= AV_TIME_BASE) {
+            uint64_t bitrate = ds->cardbili_bitrate_bytes * 8.0 * AV_TIME_BASE / duration;
+            atomic_store_explicit(&ds->cardbili_bitrate, bitrate, memory_order_relaxed);
+            ds->cardbili_bitrate_bytes = 0;
+        }
+    }
+
     ds->data_size += pkt->size;
     ds->nb_packets++;
 
