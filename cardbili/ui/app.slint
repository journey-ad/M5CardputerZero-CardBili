import "../fonts/fusion12.ttf";
export { HomeTab, Page, VideoLayout, MenuPosition, SettingsItem } from "types.slint";
export { VideoRow, HistoryHeader } from "common.slint";
export { Nav, ListModel, Status, Account, Player, Danmaku, Detail, Login, Meta, Preferences, Collection, Menu, Comments, Favorite, Following, Confirm, Cdn, Sections } from "state.slint";
import { Confirm, Nav, Sections } from "state.slint";
import { Page } from "types.slint";
import { StatusBar } from "components/status_bar.slint";
import { BottomBar } from "components/bottom_bar.slint";
import { Router } from "router.slint";
import { PanelHost } from "components/panel_host.slint";
import { ConfirmDialog } from "components/confirm_dialog.slint";

export component AppWindow inherits Window {
    width: 320px;
    height: 170px;
    background: #0b0f17;
    default-font-family: "Fusion Pixel 12px Prop zh-Hans";

    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: #0b0f17; }

    Router {}
    PanelHost {}
    BottomBar {
        x: 0px;
        y: parent.height - self.height;
        width: parent.width;
        visible: Nav.page != Page.player || Sections.open;
    }
    StatusBar {
        x: (parent.width - self.width) / 2;
        y: parent.height - (Nav.page == Page.player ? 50px : 46px);
    }
    if Confirm.open: ConfirmDialog {}
}
