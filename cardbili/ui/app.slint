import "../fonts/fusion12.ttf";
export { HomeTab, Page, VideoLayout, MenuPosition } from "types.slint";
export { SettingsPage, SettingsItem } from "components/panels/settings.slint";
export { MinePage, MineEntry } from "components/panels/mine.slint";
export { VideoRow, HistoryHeader, SuperChatRow } from "common.slint";
export { Comments, CommentRow } from "components/video/comments.slint";
export { EmojiFont, EmojiPlacement } from "components/base/text.slint";
export { Nav, Layout, ListModel, LiveAreas, Status, Account, Player, Danmaku, SuperChat, Detail, Login, Meta, Preferences, Collection, Menu, Favorite, Following, Confirm, Cdn, Sections, I18n } from "state.slint";
import { Confirm, Nav, Sections, Layout } from "state.slint";
import { Page } from "types.slint";
import { StatusBar } from "components/feedback/status.slint";
import { BottomBar } from "components/navigation/bottom.slint";
import { Router } from "router.slint";
import { PanelHost } from "components/panels/host.slint";
import { ConfirmDialog } from "components/feedback/confirm.slint";

export component AppWindow inherits Window {
    width <=> Layout.window-width;
    height <=> Layout.window-height;
    background: #0b0f17;
    default-font-family: "Fusion Pixel 12px Prop zh-Hans";

    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: #0b0f17; }

    Router {}
    PanelHost {}
    BottomBar {
        height: Layout.bottom-bar-height;
        x: 0px;
        y: parent.height - self.height;
        width: parent.width;
        visible: Nav.page != Page.player || Sections.open;
    }
    StatusBar {
        x: (parent.width - self.width) / 2;
        y: parent.height - (Nav.page == Page.player ? 50px : 46px);
    }
    if Confirm.open: ConfirmDialog {}
}
