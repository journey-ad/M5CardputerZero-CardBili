// 页面与组件共享的数据结构
export struct Cmt {
    user: string,
    text: string,
}

export struct CommentRow {
    user: string,
    text: string,
    time: string,
    likes: string,
}

// 醒目留言行：金额、剩余秒数、正文与等级配色
export struct SuperChatRow {
    user: string,
    price: string,
    remaining: int,
    text: string,
    accent: color,
    background: color,
    foreground: color,
}

// 弹幕行：位置由 Rust 每帧算好
export struct DmRow {
    text: string,
    x: length,
    y: length,
    color: color,
    img: image,
}

export struct VideoRow {
    title: string,
    author: string,
    duration: string,
    views: string,
    likes: string,
    danmaku: string,
    progress: string,
    watched: string,
}
export struct HistoryHeader {
    title: string,
    top: float,
}

export struct FollowingRow {
    user: string,
    text: string,
    avatar: image,
    has-avatar: bool,
    header: bool,
}

export struct FavoriteRow {
    title: string,
    count: string,
    visibility: string,
    cover: image,
    has-cover: bool,
}
