// 页面与组件共享的数据结构
export struct Cmt {
    user: string,
    text: string,
}

// 弹幕行：位置由 Rust 每帧算好
export struct DmRow {
    text: string,
    x: length,
    y: length,
    w: length,
    h: length,
    color: color,
    img: image,
}

export struct VideoRow {
    title: string,
    author: string,
    duration: string,
    views: string,
    likes: string,
    danmaku: string,
}

export struct FollowingRow {
    user: string,
    text: string,
    avatar: image,
    has-avatar: bool,
}
