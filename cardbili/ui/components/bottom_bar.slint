// 菜单中心与实体 4–8 键对应，侧栏外的槽位由 Rust 分配
import { Menu, Preferences } from "../state.slint";

export component BottomBar inherits Rectangle {
    x: Preferences.menu-position == 1 ? 56px : 0px;
    height: 20px;
    background: #121a2a;

    property <[length]> centers: [49px, 106px, 162px, 217px, 275px];
    for label[index] in Menu.labels: Text {
        x: root.centers[index] - root.x - 27px; y: 0px;
        width: 54px; height: 20px; text: label;
        color: label == "返回" ? #ffcf6e : (label == "说明" ? #c9a0ff : #7fb0ff);
        font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
    }
}
