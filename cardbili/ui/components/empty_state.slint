// 空状态：加载中 / 加载失败（两行）/ 无内容
import { ListModel, Status } from "../state.slint";

export component EmptyState inherits Rectangle {
    background: transparent;

    // 加载中
    if ListModel.loading: Text {
        x: 0px; y: parent.height / 2 - 8px; width: parent.width; height: 16px;
        text: "加载中…";
        color: #8b95a7; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
    }

    // 错误：第一行友好提示，第二行技术信息
    if !ListModel.loading && Status.detail != "": Rectangle {
        Text {
            x: 0px; y: parent.height / 2 - 18px; width: parent.width; height: 16px;
            text: Status.status == "" ? "加载失败" : Status.status;
            color: #d3d9e3; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
        }
        Text {
            x: 8px; y: parent.height / 2; width: parent.width - 16px; height: 14px;
            text: Status.detail;
            color: #6b7688; font-size: 9px;
            horizontal-alignment: center; vertical-alignment: center;
            wrap: word-wrap; overflow: elide;
        }
    }

    // 无内容
    if !ListModel.loading && Status.detail == "": Rectangle {
        Text {
            x: 0px; y: parent.height / 2 - 16px; width: parent.width; height: 16px;
            text: Status.status == "" ? "暂无内容" : Status.status;
            color: #8b95a7; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
        }
        Text {
            x: 0px; y: parent.height / 2 + 2px; width: parent.width; height: 12px;
            text: "按 R 刷新";
            color: #5f6b7f; font-size: 9px; horizontal-alignment: center; vertical-alignment: center;
        }
    }
}
