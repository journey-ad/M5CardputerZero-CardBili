// 视频卡片：封面、时长角标、标题、统计与作者
import { ListModel } from "../state.slint";
import { Icons } from "icons.slint";
import { StatItem } from "stat_item.slint";

export component GridView inherits Rectangle {
    clip: true;

    for video[i] in ListModel.grid-rows: Rectangle {
        x: Math.mod(i, ListModel.cols) * ListModel.cell-w;
        y: ((i - Math.mod(i, ListModel.cols)) / ListModel.cols) * ListModel.cell-h - ListModel.grid-offset;
        width: ListModel.cell-w;
        height: ListModel.cell-h;
        background: #0f1623;
        thumbnail := Image {
            x: 1px; y: 1px; width: parent.width - 2px;
            height: parent.height - ((video.views != "" || video.danmaku != "" || video.progress != "" || video.watched != "") ? 42px : 30px);
            source: ListModel.grid-covers[i]; image-fit: cover;
        }
        if video.duration != "": Rectangle {
            x: thumbnail.x + thumbnail.width - self.width - 4px;
            y: thumbnail.y + thumbnail.height - self.height - 4px;
            width: duration.preferred-width + 8px; height: 14px;
            background: #000000b8; border-radius: 2px;
            duration := Text {
                x: 4px; y: 0px; height: parent.height;
                text: video.duration; color: #ffffff;
                font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
                vertical-alignment: center;
            }
        }
        Text {
            x: 3px; y: thumbnail.y + thumbnail.height; width: parent.width - 6px; height: 14px;
            text: video.title; color: #e6ebf5; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
            vertical-alignment: center; overflow: elide;
        }
        if video.views != "" || video.danmaku != "" || video.progress != "" || video.watched != "" : HorizontalLayout {
            x: 2px; y: thumbnail.y + thumbnail.height + 14px;
            width: parent.width - 4px; height: 12px;
            spacing: 4px; alignment: start;
            if video.views != "": StatItem { text-size: ListModel.cols == 3 ? 8px : 10px; text-font: ListModel.cols == 3 ? "Fusion Pixel 8px Prop zh-Hans" : "Fusion Pixel 10px Prop zh-Hans"; icon-gap: 0px; icon: Icons.play; value: video.views; }
            if video.danmaku != "": StatItem { text-size: ListModel.cols == 3 ? 8px : 10px; text-font: ListModel.cols == 3 ? "Fusion Pixel 8px Prop zh-Hans" : "Fusion Pixel 10px Prop zh-Hans"; icon-gap: 0px; icon: Icons.message-text; value: video.danmaku; }
            if video.progress != "": StatItem { text-size: ListModel.cols == 3 ? 8px : 10px; text-font: ListModel.cols == 3 ? "Fusion Pixel 8px Prop zh-Hans" : "Fusion Pixel 10px Prop zh-Hans"; icon-gap: 0px; icon: Icons.play; value: video.progress; }
            if video.watched != "": StatItem { text-size: ListModel.cols == 3 ? 8px : 10px; text-font: ListModel.cols == 3 ? "Fusion Pixel 8px Prop zh-Hans" : "Fusion Pixel 10px Prop zh-Hans"; icon-gap: 0px; icon: Icons.clock; value: video.watched; }
        }
        Text {
            x: 3px; y: parent.height - 15px; width: parent.width - 6px; height: 14px;
            text: video.author; color: #6f7c92; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
            vertical-alignment: center; overflow: elide;
        }
        if i == ListModel.grid-active: Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            border-width: 2px; border-color: #7fb0ff;
        }
    }
}
