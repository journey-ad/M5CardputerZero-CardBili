    out property <image> hot: @image-url("../../assets/pixelarticons/hot.svg");
    out property <image> super-chat: @image-url("../../assets/pixelarticons/super-chat.svg");
    out property <image> user: @image-url("../../assets/pixelarticons/user.svg");
    out property <image> settings-cog: @image-url("../../assets/pixelarticons/settings-cog.svg");
    out property <image> clock: @image-url("../../assets/pixelarticons/clock.svg");
    out property <image> thumbs-up: @image-url("../../assets/pixelarticons/thumbs-up.svg");
    out property <image> coins: @image-url("../../assets/pixelarticons/coins.svg");
    out property <image> bookmark: @image-url("../../assets/pixelarticons/bookmark.svg");
    out property <image> message-text: @image-url("../../assets/pixelarticons/message-text.svg");
    out property <image> play: @image-url("../../assets/pixelarticons/play-solid.svg");
    out property <image> pause: @image-url("../../assets/pixelarticons/pause-solid.svg");
    out property <image> left: @image-url("../../assets/pixelarticons/chevron-left.svg");
    out property <image> right: @image-url("../../assets/pixelarticons/chevron-right.svg");
