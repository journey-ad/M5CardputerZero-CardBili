// 选中项到达可视区边缘时滚动列表
import { Nav, ListModel } from "../state.slint";
import { Icons } from "icons.slint";
import { StatItem } from "stat_item.slint";

export component ListView inherits Rectangle {
    clip: true;
    for row[i] in ListModel.rows: Rectangle {
        x: 0px; y: (i - ListModel.first-row) * 30px;
        width: parent.width; height: 30px;
        background: i == Nav.sel ? #1f2b45 : transparent;
        Rectangle { y: 29px; width: parent.width; height: 1px; background: #151d2c; }
        Rectangle {
            x: 8px; y: 1px; width: parent.width - 16px; height: 17px; clip: true;
            Text {
                x: i == Nav.sel && ListModel.title-marquee ? -ListModel.title-shift : 0px;
                width: i == Nav.sel && ListModel.title-marquee ? self.preferred-width : parent.width;
                height: 17px; text: row.title; color: #e6ebf5;
                font-size: 12px; vertical-alignment: center; overflow: elide;
            }
        }
        HorizontalLayout {
            x: 8px; y: 17px; width: parent.width - 16px; height: 12px; spacing: 4px;
            StatItem { icon: Icons.clock; value: row.duration; }
            StatItem { icon: Icons.play; value: row.views; }
            StatItem { icon: Icons.thumbs-up; value: row.likes; }
            Rectangle {
                horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; clip: true;
                Text {
                    x: 0px; y: 0px; width: parent.width; height: 12px;
                    text: row.author; color: #6f7c92;
                    font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
                    horizontal-alignment: right; vertical-alignment: center;
                }
            }
        }
    }
}
