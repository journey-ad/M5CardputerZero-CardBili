import { Text } from "../base/text.slint";
// 我的页：账号信息卡与关注、历史、收藏、稍后再看入口
import { Icon, Icons } from "../base/icons.slint";
import { Nav, ListModel, Account, I18n } from "../../state.slint";

export struct MineEntry {
    label: string,
    icon: image,
}

export global MinePage {
    out property <[MineEntry]> entries: [
        { label: I18n.tr("我的关注"), icon: Icons.user },
        { label: I18n.tr("历史观看"), icon: Icons.clock },
        { label: I18n.tr("我的收藏"), icon: Icons.bookmark },
        { label: I18n.tr("稍后再看"), icon: Icons.clock-plus },
    ];
}

export component MinePanel inherits Rectangle {
    clip: true;
    Rectangle {
    y: -max(0px, 52px + (Nav.sel + 1) * 28px - root.height);
    width: parent.width; height: 60px + MinePage.entries.length * 28px;

    Rectangle { x: 6px; y: 4px; width: parent.width - 12px; height: 44px; background: #121a2a; border-radius: 6px; }
    if Account.has-avatar: Image { x: 12px; y: 10px; width: 32px; height: 32px; source: Account.avatar; image-fit: cover; }
    if !Account.has-avatar: Rectangle { x: 12px; y: 10px; width: 32px; height: 32px; background: #1d2740; border-radius: 16px; }
    Text { x: 52px; y: 7px; width: parent.width - 60px; height: 16px; text: Account.logged ? Account.name : (Account.known ? I18n.tr("正在获取账号信息…") : I18n.tr("未登录")); color: #e6ebf5; font-size: 12px; vertical-alignment: center; overflow: elide; }
    Text { x: 52px; y: 23px; width: parent.width - 60px; height: 12px; text: Account.logged ? "UID " + Account.mid : (Account.known ? I18n.tr("请稍候") : I18n.tr("按 登录 键扫码登录")); color: #8b95a7; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; vertical-alignment: center; }
    if Account.logged: Text { x: 52px; y: 34px; width: parent.width - 60px; height: 11px; text: Account.level + "  " + Account.vip; color: #c9a0ff; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; vertical-alignment: center; }

    for e[i] in MinePage.entries: Rectangle {
        x: 6px; y: 52px + i * 28px; width: parent.width - 12px; height: 26px;
        background: i == Nav.sel ? #1f2b45 : #0f1623;
        border-radius: 4px;
        Icon { x: 8px; y: 7px; width: 12px; height: 12px; source: e.icon; colorize: #7fb0ff; }
        Text { x: 26px; y: 0px; width: 112px; height: 26px; text: e.label; color: #e6ebf5; font-size: 12px; vertical-alignment: center; }
        Icon { x: parent.width - 22px; y: 7px; source: Icons.right; colorize: #6f7c92; }
    }
}
}
