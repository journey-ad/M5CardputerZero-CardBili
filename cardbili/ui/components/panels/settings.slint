import { VideoLayout, MenuPosition } from "../../types.slint";
import { Nav, Preferences, Meta, I18n } from "../../state.slint";
import { Icon, Icons } from "../base/icons.slint";
import { ToggleSwitch } from "../base/switch.slint";
import { Text } from "../base/text.slint";

export enum SettingsItem {
    list-style, danmaku, danmaku-opacity, menu-position, record-history,
    debug-log, cdn, cache, about, emoji-style, pixel-optimize, scale-algorithm, language, title-translate,
    voice-backend, voice-punctuation, voice-add-spaces,
}

export enum SettingsKind { choice, toggle, action }

export struct SettingsRow {
    item: SettingsItem,
    label: string,
    kind: SettingsKind,
    value: string,
    checked: bool,
    disabled: bool,
}

export struct SettingsGroupData {
    title: string,
    rows: [SettingsRow],
}

export global SettingsChoice {
    in-out property <bool> open: false;
    in-out property <SettingsItem> item;
    in-out property <string> title;
    in-out property <[string]> options;
    in-out property <int> current;
    in-out property <int> selected;
    in-out property <int> first;
    out property <int> visible-count: min(4, self.options.length);
    callback key(string);
}

export global SettingsPage {
    out property <[SettingsGroupData]> groups: [
        // 外观设置
        {
            title: I18n.tr("外观设置"),
            rows: [
                {
                    item: SettingsItem.menu-position, label: I18n.tr("首页布局"), kind: SettingsKind.choice,
                    value: Preferences.menu-position == MenuPosition.top ? I18n.tr("顶部") : (Preferences.menu-position == MenuPosition.left ? I18n.tr("左侧") : I18n.tr("右侧")),
                },
                {
                    item: SettingsItem.list-style, label: I18n.tr("视频列表风格"), kind: SettingsKind.choice,
                    value: Nav.view == VideoLayout.list ? I18n.tr("列表") : (Nav.view == VideoLayout.three-columns ? I18n.tr("3列") : I18n.tr("2列")),
                },
                { item: SettingsItem.danmaku, label: I18n.tr("弹幕默认开关"), kind: SettingsKind.toggle, checked: Preferences.danmaku-default },
                { item: SettingsItem.danmaku-opacity, label: I18n.tr("弹幕不透明度"), kind: SettingsKind.choice, value: Preferences.danmaku-opacity + "%" },
                { item: SettingsItem.emoji-style, label: I18n.tr("Emoji样式"), kind: SettingsKind.choice, value: "😀😆😎" },
            ],
        },
        // 常规设置
        {
            title: I18n.tr("常规设置"),
            rows: [
                { item: SettingsItem.language, label: "语言 / Language", kind: SettingsKind.choice, value: I18n.lang == 0 ? "简体中文" : "English" },
                { item: SettingsItem.title-translate, label: I18n.tr("标题翻译"), kind: SettingsKind.choice, value: Preferences.translate-provider-name },
                { item: SettingsItem.record-history, label: I18n.tr("记录播放历史"), kind: SettingsKind.toggle, checked: Preferences.record-history },
                { item: SettingsItem.cache, label: I18n.tr("缓存占用"), kind: SettingsKind.action, value: Preferences.cache-size },
                { item: SettingsItem.about, label: I18n.tr("关于"), kind: SettingsKind.action, value: Meta.version },
            ],
        },
        // 语音输入
        {
            title: I18n.tr("语音输入"),
            rows: [
                { item: SettingsItem.voice-backend, label: I18n.tr("识别引擎"), kind: SettingsKind.choice, value: Preferences.voice-backend-name },
                { item: SettingsItem.voice-punctuation, label: I18n.tr("标点设置"), kind: SettingsKind.choice, value: Preferences.voice-punctuation-name },
                { item: SettingsItem.voice-add-spaces, label: I18n.tr("中英文之间添加空格"), kind: SettingsKind.toggle, checked: Preferences.voice-add-spaces },
            ],
        },
        // 进阶设置
        {
            title: I18n.tr("进阶设置"),
            rows: [
                { item: SettingsItem.debug-log, label: I18n.tr("调试日志"), kind: SettingsKind.toggle, checked: Preferences.debug-log },
                { item: SettingsItem.cdn, label: I18n.tr("CDN 设置"), kind: SettingsKind.action, value: Preferences.cdn-name },
                { item: SettingsItem.pixel-optimize, label: I18n.tr("像素优化"), kind: SettingsKind.toggle, checked: Preferences.pixel-optimize },
                {
                    item: SettingsItem.scale-algorithm, label: I18n.tr("采样算法"), kind: SettingsKind.choice,
                    value: Preferences.pixel-optimize ? I18n.tr("随像素优化") : Preferences.scale-algorithm-name,
                    disabled: Preferences.pixel-optimize,
                },
            ],
        },
    ];
    in-out property <int> first-line: 0;
    in-out property <int> selected-group: 0;
    in-out property <int> selected-row: 0;
}

// 单个设置项，各分组共用
component SettingsRowItem inherits Rectangle {
    in property <SettingsRow> entry;
    in property <bool> selected: false;
    property <bool> is-toggle: entry.kind == SettingsKind.toggle;
    property <bool> adjustable: entry.kind != SettingsKind.action;
    background: selected ? #1f2b45 : #0f1623;
    border-radius: 3px;

    Text {
        x: 10px;
        // 开关只占右侧约 50px，其余行需为选择器留出 130px；仍放不下时省略号截断
        width: parent.width - (is-toggle ? 64px : 144px);
        height: parent.height;
        text: entry.label;
        color: selected ? #e6ebf5 : #9aa6ba;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    if is-toggle: ToggleSwitch {
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        checked: root.entry.checked;
    }
    if adjustable && !is-toggle: Rectangle {
        x: parent.width - 130px;
        width: 120px;
        height: parent.height;
        Icon {
            x: 2px; y: 1px; width: 20px; height: 20px;
            source: Icons.left;
            colorize: root.entry.disabled ? #4a5568 : (selected ? #7fb0ff : #6f7c92);
            opacity: root.entry.disabled ? 0.5 : (entry.item == SettingsItem.danmaku-opacity && Preferences.danmaku-opacity == 0 ? 0.3 : 1);
        }
        Text {
            x: 24px; width: 72px; height: parent.height;
            text: entry.value;
            color: root.entry.disabled ? #4a5568 : (selected ? #7fb0ff : #9aa6ba);
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Icon {
            x: 98px; y: 1px; width: 20px; height: 20px;
            source: Icons.right;
            colorize: root.entry.disabled ? #4a5568 : (selected ? #7fb0ff : #6f7c92);
            opacity: root.entry.disabled ? 0.5 : (entry.item == SettingsItem.danmaku-opacity && Preferences.danmaku-opacity == 100 ? 0.3 : 1);
        }
    }
    if !adjustable: Text {
        x: parent.width - (entry.item == SettingsItem.cache ? 154px : 130px); width: entry.item == SettingsItem.cache ? 118px : 94px; height: parent.height;
        text: entry.value;
        overflow: elide; color: #9aa6ba;
        font-size: 12px;
        font-family: "Fusion Pixel 12px Prop zh-Hans";
        horizontal-alignment: right; vertical-alignment: center;
    }
    if !adjustable: Icon {
        x: parent.width - 32px; y: 1px; width: 20px; height: 20px;
        source: Icons.right;
        colorize: selected ? #7fb0ff : #6f7c92;
    }
}

component SettingsGroup inherits Rectangle {
    in property <string> title;
    in property <[SettingsRow]> rows;
    in property <int> selected-index: -1;
    width: 100%;
    height: (rows.length + 1) * 24px;

    Text {
        x: 16px;
        y: 0px;
        width: parent.width - 32px;
        height: 24px;
        text: root.title;
        color: #6f7c92;
        font-size: 10px;
        font-family: "Fusion Pixel 10px Prop zh-Hans";
        vertical-alignment: center;
    }
    for row[i] in root.rows: SettingsRowItem {
        entry: row;
        selected: root.selected-index == i;
        x: 6px;
        y: (i + 1) * 24px;
        width: parent.width - 12px;
        height: 22px;
    }
}

export component SettingsPanel inherits Rectangle {
    clip: true;
    VerticalLayout {
        y: 4px - SettingsPage.first-line * 24px;
        width: parent.width; height: self.preferred-height;
        padding: 0px; spacing: 0px;
        for group[index] in SettingsPage.groups: SettingsGroup {
            title: group.title;
            rows: group.rows;
            selected-index: index == SettingsPage.selected-group ? SettingsPage.selected-row : -1;
        }
    }
}
