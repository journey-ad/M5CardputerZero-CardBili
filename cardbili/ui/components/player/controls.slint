import { Icon, Icons } from "../base/icons.slint";
import { Player, Danmaku, SuperChat, I18n } from "../../state.slint";

export component PlaybackBar inherits Rectangle {
    height: 28px; background: #000000b0;
    if !Player.live: Rectangle { x: 6px; y: 3px; width: parent.width - 12px; height: 3px; background: #2a3346; border-radius: 2px; }
    if !Player.live: Rectangle { x: 6px; y: 3px; width: (parent.width - 12px) * Player.progress; height: 3px; background: #6ea8ff; border-radius: 2px; }
    // 控制项依次对应实体 4–8 键
    Icon { x: 6px; y: 11px; source: Player.paused || Player.finished ? Icons.play : Icons.pause; }
    Text {
        x: 20px; y: 11px; width: 68px; height: 12px;
        text: Player.time-text; color: #cfd8e6;
        font-family: "Fusion Pixel 8px Prop zh-Hans"; font-size: 8px;
        vertical-alignment: center; overflow: elide;
    }
    TouchArea { x: 0px; y: 8px; width: 79px; height: 20px; clicked => { Player.key("SPACE"); } }
    Icon {
        x: 100px; y: 11px; source: Player.live ? Icons.reload : Icons.thumbs-up;
        colorize: !Player.live && Player.liked ? #ff77a8 : #cfd8e6;
    }
    TouchArea {
        x: 79px; y: 8px; width: 54px; height: 20px;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { Player.key(Player.live ? "r" : "l"); }
            if !Player.live && event.button == PointerEventButton.left && event.kind == PointerEventKind.up { Player.key("LIKE_UP"); }
            if !Player.live && event.kind == PointerEventKind.cancel { Player.key("LIKE_CANCEL"); }
        }
    }
    if !Player.live: Icon {
        x: 154px; y: 12px; width: 14px; height: 10px;
        source: @image-url("../../../assets/pixelarticons/badge-captions-wide.svg");
        colorize: Player.subtitle-selected > 0 ? #7fb0ff : #697487;
        opacity: Player.subtitle-labels.length > 1 ? 1 : 0.35;
    }
    if !Player.live: TouchArea {
        x: 135px; y: 8px; width: 54px; height: 20px;
        enabled: Player.subtitle-labels.length > 1;
        clicked => { Player.key("SUBTITLE"); }
    }
    if Player.live && SuperChat.available: Icon { x: (parent.width - self.width) / 2; y: 11px; width: 14px; source: Icons.super-chat; }
    if Player.live && SuperChat.available: TouchArea { x: 135px; y: 8px; width: 54px; height: 20px; clicked => { Player.key("SUPER_CHAT"); } }
    Rectangle {
        x: 211px; y: 11px; width: 12px; height: 12px;
        border-width: 1px; border-color: Danmaku.enabled ? #7fb0ff : #697487;
        Text {
            x: 1px; y: 1px; width: 10px; height: 10px; text: I18n.tr("弹");
            color: Danmaku.enabled ? #7fb0ff : #697487;
            font-family: "Fusion Pixel 8px Prop zh-Hans"; font-size: 8px;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    TouchArea {
        x: 190px; y: 8px; width: 54px; height: 20px;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { Player.key("DANMAKU"); }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up { Player.key("DANMAKU_UP"); }
            if event.kind == PointerEventKind.cancel { Player.key("DANMAKU_CANCEL"); }
        }
    }
    Icon { x: 269px; y: 11px; source: Icons.more-vertical; }
    TouchArea { x: 248px; y: 8px; width: 54px; height: 20px; clicked => { Player.key("m"); } }
}
