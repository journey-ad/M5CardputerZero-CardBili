import { Nav, Preferences, Danmaku } from "../state.slint";
import { Icon, Icons } from "icons.slint";

export component SettingsPanel inherits Rectangle {
    for label[index] in ["列表风格", "弹幕开关", "弹幕不透明度", "界面布局", "关于"]: Rectangle {
        x: 6px;
        y: 4px + index * 24px;
        width: parent.width - 12px;
        height: 22px;
        background: index == Nav.sel ? #1f2b45 : #0f1623;
        border-radius: 3px;

        Text {
            x: 10px;
            width: parent.width - 144px;
            height: parent.height;
            text: label;
            color: index == Nav.sel ? #e6ebf5 : #9aa6ba;
            font-size: 12px;
            vertical-alignment: center;
        }
        if index < 4: Rectangle {
            x: parent.width - 130px;
            width: 120px;
            height: parent.height;
            Icon {
                x: 2px; y: 1px; width: 20px; height: 20px;
                source: Icons.left;
                colorize: index == Nav.sel ? #7fb0ff : #6f7c92;
                opacity: index == 2 && Preferences.danmaku-opacity == 0 ? 0.3 : 1;
            }
            Text {
                x: 24px; width: 72px; height: parent.height;
                text: [
                    ["列表", "3列", "2列"][Nav.view],
                    Danmaku.enabled ? "开启" : "关闭",
                    Preferences.danmaku-opacity + "%",
                    ["顶部", "左侧", "右侧"][Preferences.menu-position],
                ][index];
                color: index == Nav.sel ? #7fb0ff : #9aa6ba;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Icon {
                x: 98px; y: 1px; width: 20px; height: 20px;
                source: Icons.right;
                colorize: index == Nav.sel ? #7fb0ff : #6f7c92;
                opacity: index == 2 && Preferences.danmaku-opacity == 100 ? 0.3 : 1;
            }
        }
        if index == 4: Icon {
            x: parent.width - 32px; y: 1px; width: 20px; height: 20px;
            source: Icons.right;
            colorize: index == Nav.sel ? #7fb0ff : #6f7c92;
        }
    }
}
