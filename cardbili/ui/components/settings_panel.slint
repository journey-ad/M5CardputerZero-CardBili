import { VideoLayout, MenuPosition } from "../types.slint";
import { Nav, Preferences, Danmaku, Meta } from "../state.slint";
import { Icon, Icons } from "icons.slint";

export component SettingsPanel inherits Rectangle {
    clip: true;
    property <int> first: max(0, Nav.sel - floor((root.height - 4px) / 24px) + 1);
    for label[index] in ["视频列表风格", "弹幕开关", "弹幕不透明度", "首页布局", "记录播放历史", "关于"]: Rectangle {
        x: 6px;
        y: 4px + (index - root.first) * 24px;
        width: parent.width - 12px;
        height: 22px;
        background: index == Nav.sel ? #1f2b45 : #0f1623;
        border-radius: 3px;

        Text {
            x: 10px;
            width: parent.width - 144px;
            height: parent.height;
            text: label;
            color: index == Nav.sel ? #e6ebf5 : #9aa6ba;
            font-size: 12px;
            vertical-alignment: center;
        }
        if index < 5: Rectangle {
            x: parent.width - 130px;
            width: 120px;
            height: parent.height;
            Icon {
                x: 2px; y: 1px; width: 20px; height: 20px;
                source: Icons.left;
                colorize: index == Nav.sel ? #7fb0ff : #6f7c92;
                opacity: index == 2 && Preferences.danmaku-opacity == 0 ? 0.3 : 1;
            }
            Text {
                x: 24px; width: 72px; height: parent.height;
                text: [
                    Nav.view == VideoLayout.list ? "列表" : (Nav.view == VideoLayout.three-columns ? "3列" : "2列"),
                    Danmaku.enabled ? "开启" : "关闭",
                    Preferences.danmaku-opacity + "%",
                    Preferences.menu-position == MenuPosition.top ? "顶部" : (Preferences.menu-position == MenuPosition.left ? "左侧" : "右侧"),
                    Preferences.record-history ? "开启" : "关闭",
                ][index];
                color: index == Nav.sel ? #7fb0ff : #9aa6ba;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Icon {
                x: 98px; y: 1px; width: 20px; height: 20px;
                source: Icons.right;
                colorize: index == Nav.sel ? #7fb0ff : #6f7c92;
                opacity: index == 2 && Preferences.danmaku-opacity == 100 ? 0.3 : 1;
            }
        }
        if index == 5: Text {
            x: parent.width - 130px; width: 94px; height: parent.height;
            text: Meta.version; color: #9aa6ba; font-size: 12px;
            horizontal-alignment: right; vertical-alignment: center;
        }
        if index == 5: Icon {
            x: parent.width - 32px; y: 1px; width: 20px; height: 20px;
            source: Icons.right;
            colorize: index == Nav.sel ? #7fb0ff : #6f7c92;
        }
    }
}
