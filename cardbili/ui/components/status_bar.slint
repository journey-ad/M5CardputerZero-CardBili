import { Text } from "text.slint";
// 浮动状态提示显示在内容上方，数秒后自动消失
import { Status } from "../state.slint";

export component StatusBar inherits Rectangle {
    width: tb.preferred-width + 24px;
    height: 18px;
    border-radius: 9px;
    background: #1c2434;
    visible: Status.bar != "";

    tb := Text {
        x: 12px;
        y: 0px;
        height: parent.height;
        text: Status.bar;
        color: #cdd4e0;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        vertical-alignment: center;
    }

    Timer {
        interval: 3s;
        running: Status.bar != "" && !Status.bar-sticky;
        triggered => {
            Status.bar = "";
        }
    }
}
