import { RichText } from "../base/rich-text.slint";
import { Text, EmojiFont, RichLayout } from "../base/text.slint";
import { Icons } from "../base/icons.slint";
import { StatItem } from "../base/stat.slint";
import { Comments, Layout } from "../../state.slint";

export component CommentList inherits VerticalLayout {
    spacing: 4px;
    property <string> text-font: "Fusion Pixel 10px Prop zh-Hans";
    property <length> text-size: 10px;
    property <length> text-height: EmojiFont.rich-layout("", 1px, root.text-font, root.text-size, EmojiFont.revision).height;
    property <length> card-padding: 4px;
    property <length> content-gap: 3px;
    property <length> stats-height: 12px;
    for comment in Comments.rows: card := Rectangle {
        property <RichLayout> body-layout: EmojiFont.rich-layout(comment.text, self.width - 2 * root.card-padding, root.text-font, root.text-size, EmojiFont.revision);
        height: self.body-layout.height + root.text-height + root.stats-height + 2 * (root.card-padding + root.content-gap);
        // 屏外评论保留行高，进入屏幕时创建内容
        if card.absolute-position.y < Layout.window-height && card.absolute-position.y + card.height > 0px: Rectangle {
            width: parent.width; height: parent.height;
            background: #101726;
            VerticalLayout {
                padding: root.card-padding; spacing: root.content-gap;
                Text {
                    text: comment.user; color: #7fb0ff;
                    font-size: root.text-size; font-family: root.text-font;
                    height: root.text-height; overflow: elide;
                }
                RichText {
                    layout: card.body-layout; color: #cfd8e6;
                    font-size: root.text-size; font-family: root.text-font;
                }
                HorizontalLayout {
                    height: root.stats-height;
                    alignment: start;
                    spacing: 8px;
                    StatItem { icon: Icons.thumbs-up; value: comment.likes; }
                    Text {
                        text: comment.time; color: #8b95a7;
                        font-size: root.text-size; font-family: root.text-font;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    if Comments.finished && Comments.rows.length > 0: Rectangle { height: 1px; background: #3a4a66; }
    if Comments.loading || Comments.error != "" || Comments.finished: Text {
        text: Comments.loading ? "评论加载中…" : (Comments.error != "" ? "评论加载失败，按 R 重试" : (Comments.rows.length == 0 ? "暂无评论" : "全部评论已加载完毕"));
        color: #8b95a7; font-size: 10px; font-family: "Fusion Pixel 10px Prop zh-Hans";
        wrap: word-wrap; horizontal-alignment: center;
    }
}
