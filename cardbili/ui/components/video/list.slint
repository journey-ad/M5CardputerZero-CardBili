import { Text } from "../base/text.slint";
// 选中项到达可视区边缘时滚动列表
import { Nav, ListModel, I18n } from "../../state.slint";
import { Icons } from "../base/icons.slint";
import { HomeTab, Page } from "../../types.slint";
import { StatItem } from "../base/stat.slint";

export component ListView inherits Rectangle {
    in property <bool> show-author: true;
    // 收藏夹视频列表展示弹幕数量
    property <bool> show-danmaku: Nav.page == Page.collection;
    clip: true;
    property <bool> live: Nav.page == Page.home && Nav.tab == HomeTab.live;
    property <length> max-top: max(0px, ListModel.content-height * 1px - root.height);
    property <length> top: min(ListModel.scroll-y * 1px, self.max-top);
    for header in ListModel.headers: Text {
        x: 8px; y: header.top * 1px - root.top + (root.live ? 4px : 0px);
        width: parent.width - 16px; height: ListModel.header-height - (root.live ? 6px : 0px);
        text: header.title; color: #8b95a7;
        font-family: root.live ? "Fusion Pixel 12px Prop zh-Hans" : "Fusion Pixel 10px Prop zh-Hans";
        font-size: root.live ? 12px : 10px;
        vertical-alignment: center;
    }
    for row[i] in ListModel.rows: Rectangle {
        x: 0px; y: ListModel.row-tops[i] * 1px - root.top;
        width: parent.width; height: ListModel.row-height;
        background: i == Nav.sel ? #1f2b45 : transparent;
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #151d2c; }
        Rectangle {
            x: 8px; y: 1px; width: parent.width - 16px; height: 17px; clip: true;
            Text {
                x: i == Nav.sel && ListModel.title-marquee ? -ListModel.title-shift : 0px;
                width: i == Nav.sel && ListModel.title-marquee ? self.preferred-width : parent.width;
                height: 17px; text: row.title; color: #e6ebf5;
                font-size: 12px; vertical-alignment: center; overflow: elide;
            }
        }
        HorizontalLayout {
            x: 8px; y: 17px; width: parent.width - 16px; height: 12px; spacing: 4px; alignment: start;
            if row.duration != "" && row.progress == "": StatItem { icon: Icons.clock; value: row.duration; }
            if row.views != "": StatItem { icon: root.live ? Icons.hot : Icons.play; value: row.views; }
            if row.likes != "": StatItem { icon: Icons.thumbs-up; value: row.likes; }
            if root.show-danmaku && row.danmaku != "": StatItem { icon: Icons.message-text; value: row.danmaku; }
            if row.progress != "": StatItem { icon: Icons.play; show-icon: row.progress != I18n.tr("已看完"); value: row.progress; }
            if row.watched != "": StatItem { icon: Icons.clock; value: row.watched; }
        }
        Text {
            x: 8px; y: 17px; width: parent.width - 16px; height: 12px;
            visible: root.show-author;
            text: row.author; color: #8b95a7;
            font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
            horizontal-alignment: right; vertical-alignment: center;
        }
        if row.date != "": Text {
            x: 8px; y: 29px; width: parent.width - 16px; height: 12px;
            text: I18n.tr("添加于 ") + row.date; color: #8b95a7;
            font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
            vertical-alignment: center;
        }
    }
}
