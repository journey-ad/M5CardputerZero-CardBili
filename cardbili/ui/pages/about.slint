import { Meta } from "../state.slint";

export component AboutPage inherits Rectangle {
    width: 100%; height: 100%; background: #0b0f17;
    out property <length> content-height: body.preferred-height;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height - 20px; clip: true;
        body := VerticalLayout {
            x: 10px; y: -Meta.about-scroll; width: parent.width - 20px; spacing: 8px;
            Rectangle {
                height: 104px;
                Image { x: (parent.width - self.width) / 2; y: 8px; width: 48px; height: 48px; source: @image-url("../../assets/app-icon.png"); image-fit: contain; }
                Text { x: 0px; y: 62px; width: parent.width; height: 20px; text: "CardBili"; color: #7fb0ff; font-family: "Fusion Pixel 16px Prop zh-Hans"; font-size: 16px; horizontal-alignment: center; }
                Text { x: 0px; y: 86px; width: parent.width; height: 16px; text: Meta.version; color: #9aa6ba; font-size: 12px; horizontal-alignment: center; }
            }
            Text {
                text: Meta.about-text; color: #cfd8e6;
                font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
                wrap: word-wrap; horizontal-alignment: center;
            }
        }
    }
}
