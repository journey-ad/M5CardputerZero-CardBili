import { Collection, Layout } from "../state.slint";
import { VideoList } from "../components/video_list.slint";
import { Icon, Icons } from "../components/icons.slint";

export component CollectionPage inherits Rectangle {
    width: 100%; height: 100%; background: #0b0f17;
    header := Rectangle {
        x: 0px; y: 0px; width: parent.width;
        height: Layout.video-y;
        background: #121a2a;
        if Collection.is-author: Rectangle {
            x: 6px; y: 3px; width: 24px; height: 24px; background: #1f2b45;
            if Collection.has-avatar: Image { width: 100%; height: 100%; source: Collection.avatar; image-fit: cover; }
            if !Collection.has-avatar: Icon { x: 5px; y: 4px; width: 16px; height: 16px; source: Icons.user; colorize: #7fb0ff; }
        }
        if Collection.is-author: HorizontalLayout {
            x: 42px; y: 0px; width: parent.width - 48px; height: 16px;
            spacing: 4px; alignment: start;
            Text {
                max-width: parent.width - 34px; text: Collection.name;
                color: #e6ebf5; font-size: 12px; overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: Collection.level; color: #ffcf6e; font-size: 10px;
                font-family: "Fusion Pixel 10px Prop zh-Hans"; vertical-alignment: center;
            }
        }
        if Collection.is-author: Text {
            x: 42px; y: 16px; width: parent.width - 48px; height: 14px;
            text: "UID " + Collection.uid + (Collection.followers == "" ? "" : "  " + Collection.followers);
            color: #9aa6ba; font-size: 10px; font-family: "Fusion Pixel 10px Prop zh-Hans";
            vertical-alignment: center; overflow: elide;
        }
        if !Collection.is-author: Text {
            x: 8px; width: parent.width - 16px; height: parent.height;
            text: Collection.title; color: #7fb0ff; font-size: 12px;
            vertical-alignment: center; overflow: elide;
        }
    }
    videos := VideoList {
        x: 0px; y: header.height; width: Layout.video-width; height: Layout.video-height;
        show-author: !Collection.is-author;
    }
    if videos.empty: Text {
        x: 8px; y: header.height; width: parent.width - 16px; height: videos.height;
        text: Collection.loading ? "加载中…" : (Collection.error != "" ? Collection.error : (Collection.is-author ? "暂无作品" : Collection.empty));
        color: #9aa6ba; font-size: 12px; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
