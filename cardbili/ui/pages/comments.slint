import { Comments } from "../state.slint";

export component CommentsPage inherits Rectangle {
    width: 100%; height: 100%; background: #0b0f17;
    out property <length> content-height: body.preferred-height;
    out property <length> viewport-height: root.height - 44px;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 24px; background: #121a2a;
        Text { x: 8px; height: parent.height; text: "评论"; color: #7fb0ff; font-size: 12px; vertical-alignment: center; }
    }
    Rectangle {
        x: 6px; y: 24px; width: parent.width - 16px; height: parent.height - 44px; clip: true;
        body := VerticalLayout {
            y: -Comments.scroll; width: parent.width; spacing: 4px;
            for comment in Comments.rows: Rectangle {
                background: #101726;
                VerticalLayout {
                    padding: 4px; spacing: 3px;
                    Text { text: comment.user; color: #7fb0ff; font-size: 10px; font-family: "Fusion Pixel 10px Prop zh-Hans"; overflow: elide; }
                    Text { text: comment.text; color: #cfd8e6; font-size: 10px; font-family: "Fusion Pixel 10px Prop zh-Hans"; wrap: word-wrap; }
                }
            }
            Text {
                visible: Comments.loading || Comments.error != "" || Comments.rows.length == 0;
                text: Comments.loading ? "加载中…" : (Comments.error != "" ? Comments.error : "暂无评论");
                color: #8b95a7; font-size: 10px; font-family: "Fusion Pixel 10px Prop zh-Hans";
                wrap: word-wrap; horizontal-alignment: center;
            }
        }
    }
}
