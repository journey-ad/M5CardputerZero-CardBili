import { CommentList, Comments } from "../components/video/comments.slint";
import { ScrollBar } from "../components/base/scroll.slint";

export component CommentsPage inherits Rectangle {
    width: 100%; height: 100%; background: #0b0f17;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 24px; background: #121a2a;
        Text { x: 8px; height: parent.height; text: "评论"; color: #7fb0ff; font-size: 12px; vertical-alignment: center; }
    }
    Rectangle {
        x: 6px; y: 24px; width: Comments.list-width; height: Comments.viewport-h; clip: true;
        body := CommentList { y: -Comments.scroll; width: parent.width; }
    }
    ScrollBar {
        x: parent.width - 4px; y: 24px; height: Comments.viewport-h;
        content-height: Comments.content-h; scroll: Comments.scroll;
    }
}
