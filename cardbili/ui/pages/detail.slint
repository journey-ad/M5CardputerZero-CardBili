import { Text } from "../components/base/text.slint";
import { CommentList, Comments } from "../components/video/comments.slint";
// 详情页：封面、标题、统计与正文统一滚动
import { Icons } from "../components/base/icons.slint";
import { StatItem } from "../components/base/stat.slint";
import { Skeleton } from "../components/base/skeleton.slint";
import { Detail } from "../state.slint";

export component DetailPage inherits Rectangle {
    width: 100%;
    height: 100%;
    property <length> _content-h: body-lay.preferred-height;
    property <length> _viewport-h: body-viewport.height;
    property <length> _title-width: title-viewport.width;
    property <length> _title-text-width: title.preferred-width;
    changed _content-h => { Detail.content-h = self._content-h; }
    changed _viewport-h => { Detail.viewport-h = self._viewport-h; }
    changed _title-width => { Detail.title-width = self._title-width; }
    changed _title-text-width => { Detail.title-text-width = self._title-text-width; }
    init => {
        Detail.content-h = self._content-h;
        Detail.viewport-h = self._viewport-h;
        Detail.title-width = self._title-width;
        Detail.title-text-width = self._title-text-width;
    }

    background: #0b0f17;

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 20px; background: #121a2a;
        Text { x: 6px; y: 0px; width: parent.width - 12px; height: 20px; text: "视频详情"; color: #7fb0ff; font-size: 12px; vertical-alignment: center; }
    }
    body-viewport := Rectangle {
        visible: !Detail.loading && Detail.error == "";
        x: 0px; y: 24px; width: parent.width; height: parent.height - 44px; clip: true;
        body-lay := VerticalLayout {
            x: 6px; y: -Detail.scroll; width: Comments.list-width; spacing: 4px;
            Rectangle {
                height: 46px;
                Rectangle {
                    x: 0px; y: 0px; width: 64px; height: 45px; background: #121a2a;
                    if Detail.has-cover: Image {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        source: Detail.cover; image-fit: cover;
                    }
                }
                title-viewport := Rectangle {
                    x: 72px; y: 0px; width: parent.width - 72px; height: 14px; clip: true;
                    title := Text {
                        x: -Detail.title-shift; y: 0px; width: self.preferred-width; height: parent.height;
                        text: Detail.title; color: #e6ebf5; font-size: 12px; vertical-alignment: center;
                    }
                }
                Text {
                    x: 72px; y: 16px; width: parent.width - 72px; height: 12px;
                    text: Detail.bvid; color: #7d8798;
                    font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
                    vertical-alignment: center; horizontal-alignment: left;
                }
                HorizontalLayout {
                    x: 72px; y: 32px; width: parent.width - 72px; height: 12px;
                    spacing: 3px; alignment: start;
                    for glyph[index] in [Icons.clock, Icons.play, Icons.thumbs-up, Icons.coins, Icons.bookmark, Icons.message-text]: StatItem {
                        icon: glyph; value: Detail.metrics[index]; icon-gap: 1px;
                        text-size: 8px; text-font: "Fusion Pixel 8px Prop zh-Hans";
                    }
                }
            }
            Text { text: Detail.owner; color: #8b95a7; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; overflow: elide; }
            Rectangle { height: 1px; background: #1a2436; }
            Text { text: "简介"; color: #ffcf6e; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; }
            Text { text: Detail.desc; color: #cfd8e6; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; wrap: word-wrap; }
            Rectangle { height: 1px; background: #25314a; }
            Text { text: "评论"; color: #ffcf6e; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; }
            CommentList {}
        }
    }
    if !Detail.loading && Detail.error == "" && Detail.thumb-h > 0px: Rectangle {
        x: parent.width - 4px; y: body-viewport.y; width: 4px; height: body-viewport.height; background: #10141c;
        Rectangle { x: 0px; y: Detail.thumb-y; width: 4px; height: Detail.thumb-h; background: #3a4a66; border-radius: 2px; }
    }
    if root.visible && Detail.loading: Rectangle {
        x: 6px; y: 24px; width: parent.width - 18px; height: parent.height - 44px; clip: true;
        property <float> phase: Math.mod(animation-tick(), 1400ms) / 1400ms;
        Skeleton { x: 0px; y: 0px; width: 64px; height: 45px; phase: parent.phase; }
        Skeleton { x: 72px; y: 0px; width: parent.width - 72px; height: 12px; phase: parent.phase; }
        Skeleton { x: 72px; y: 18px; width: 100px; height: 8px; phase: parent.phase; }
        Skeleton { x: 72px; y: 34px; width: parent.width - 72px; height: 10px; phase: parent.phase; }
        Skeleton { x: 0px; y: 52px; width: 90px; height: 8px; phase: parent.phase; }
        Skeleton { x: 0px; y: 68px; width: parent.width; height: 10px; phase: parent.phase; }
        Skeleton { x: 0px; y: 84px; width: parent.width * 0.85; height: 10px; phase: parent.phase; }
        Skeleton { x: 0px; y: 102px; width: 54px; height: 8px; phase: parent.phase; }
        Skeleton { x: 0px; y: 116px; width: parent.width * 0.7; height: 10px; phase: parent.phase; }
    }
    if Detail.error != "": Text {
        x: 16px; y: 24px; width: parent.width - 32px; height: parent.height - 44px;
        text: Detail.error;
        color: #9aa6ba; font-size: 12px; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }

}
