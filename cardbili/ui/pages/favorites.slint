import { Text } from "../components/text.slint";
import { Favorite } from "../state.slint";
import { Icon, Icons } from "../components/icons.slint";

export component FavoritesPage inherits Rectangle {
    width: 100%; height: 100%; background: #0b0f17;
    Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: 24px; background: #121a2a;
        Text { x: 8px; height: parent.height; text: "我的收藏"; color: #7fb0ff; font-size: 12px; vertical-alignment: center; }
    }
    for folder[index] in Favorite.folders: Rectangle {
        x: 6px; y: 26px + index * 30px; width: parent.width - 12px; height: 28px;
        background: index == Favorite.selected ? #1f2b45 : #101726;
        if folder.has-cover: Image { x: 3px; y: 2px; width: 24px; height: 24px; source: folder.cover; image-fit: cover; }
        if !folder.has-cover: Icon { x: 6px; y: 6px; width: 16px; height: 16px; source: Icons.bookmark; colorize: #7fb0ff; }
        HorizontalLayout {
            x: 32px; width: parent.width - 116px; height: parent.height; spacing: 4px; alignment: start;
            Text { max-width: parent.width - 26px; text: folder.title; color: #e6ebf5; font-size: 12px; vertical-alignment: center; overflow: elide; }
            Text { text: folder.visibility; color: #8b95a7; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; vertical-alignment: center; }
        }
        Text { x: parent.width - 82px; width: 58px; height: parent.height; text: folder.count; color: #9aa6ba; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
        Icon { x: parent.width - 18px; y: 8px; source: Icons.right; colorize: #6f7c92; }
    }
    if Favorite.folders.length == 0 || Favorite.error != "": Text {
        x: 8px; y: Favorite.folders.length == 0 ? 60px : 112px; width: parent.width - 16px; height: 36px;
        text: Favorite.error != "" ? Favorite.error : (Favorite.loading ? "加载中…" : "暂无收藏夹");
        color: #9aa6ba; font-size: 12px; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
