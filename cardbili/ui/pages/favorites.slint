import { Cmt } from "../common.slint";
import { Icon, Icons } from "../components/icons.slint";

export component FavoritesPage inherits Rectangle {
    in property <[Cmt]> rows;
    in property <int> selected;
    in property <bool> loading;
    in property <string> error;
    width: 100%; height: 100%; background: #0b0f17;
    Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: 24px; background: #121a2a;
        Text { x: 8px; height: parent.height; text: "我的收藏"; color: #7fb0ff; font-size: 12px; vertical-alignment: center; }
    }
    for folder[index] in root.rows: Rectangle {
        x: 6px; y: 26px + index * 30px; width: parent.width - 12px; height: 28px;
        background: index == root.selected ? #1f2b45 : #101726;
        Icon { x: 6px; y: 6px; width: 16px; height: 16px; source: Icons.bookmark; colorize: #7fb0ff; }
        Text { x: 30px; width: parent.width - 120px; height: parent.height; text: folder.user; color: #e6ebf5; font-size: 12px; vertical-alignment: center; overflow: elide; }
        Text { x: parent.width - 88px; width: 64px; height: parent.height; text: folder.text; color: #9aa6ba; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
        Icon { x: parent.width - 18px; y: 8px; source: Icons.right; colorize: #6f7c92; }
    }
    if root.rows.length == 0 || root.error != "": Text {
        x: 8px; y: root.rows.length == 0 ? 60px : 112px; width: parent.width - 16px; height: 36px;
        text: root.error != "" ? root.error : (root.loading ? "加载中…" : "暂无收藏夹");
        color: #9aa6ba; font-size: 12px; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
