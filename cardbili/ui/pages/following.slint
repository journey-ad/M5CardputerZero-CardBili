import { Following } from "../state.slint";
import { Icon, Icons } from "../components/icons.slint";

export component FollowingPage inherits Rectangle {
    width: 100%; height: 100%; background: #0b0f17;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 24px; background: #121a2a;
        Text { x: 8px; height: parent.height; text: "我的关注"; color: #7fb0ff; font-size: 12px; vertical-alignment: center; }
    }
    for user[index] in Following.rows: Rectangle {
        x: 6px; y: 26px + index * 30px; width: parent.width - 12px; height: 28px;
        background: index == Following.selected ? #1f2b45 : #101726;
        if user.has-avatar: Image { x: 3px; y: 2px; width: 24px; height: 24px; source: user.avatar; image-fit: cover; }
        if !user.has-avatar: Icon { x: 6px; y: 6px; width: 16px; height: 16px; source: Icons.user; colorize: #7fb0ff; }
        Text { x: 30px; y: 0px; width: parent.width - 50px; height: 17px; text: user.user; color: #e6ebf5; font-size: 12px; vertical-alignment: center; overflow: elide; }
        Text { x: 30px; y: 15px; width: parent.width - 50px; height: 14px; text: user.text; color: #8b95a7; font-size: 10px; font-family: "Fusion Pixel 10px Prop zh-Hans"; vertical-alignment: center; overflow: elide; }
        Icon { x: parent.width - 18px; y: 8px; source: Icons.right; colorize: #6f7c92; }
    }
    if Following.rows.length == 0 || Following.error != "": Rectangle {
        x: 8px; y: Following.rows.length == 0 ? 60px : 112px; width: parent.width - 16px; height: 36px;
        background: #0b0f17;
        Text { width: parent.width; height: parent.height; text: Following.error != "" ? Following.error : (Following.loading ? "加载中…" : "暂无关注"); color: #9aa6ba; font-size: 10px; font-family: "Fusion Pixel 10px Prop zh-Hans"; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
    }
}
