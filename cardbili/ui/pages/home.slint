import { HomeTab, MenuPosition } from "../types.slint";
// 首页：页签 + 列表/网格/我的 三态 + 空状态 + 底部栏 + 按键说明
import { Nav, Preferences } from "../state.slint";
import { SettingsPanel } from "../components/settings_panel.slint";
import { TabBar } from "../components/tab_bar.slint";
import { VideoList } from "../components/video_list.slint";
import { MinePanel } from "../components/mine_panel.slint";
import { HelpOverlay } from "../components/help_overlay.slint";
import { EmptyState } from "../components/empty_state.slint";

export component HomePage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #0b0f17;

    property <length> content-x: Preferences.menu-position == MenuPosition.left ? 56px : 0px;
    property <length> content-y: Preferences.menu-position == MenuPosition.top ? 24px : 0px;
    property <length> content-width: root.width - (Preferences.menu-position == MenuPosition.top ? 0px : 56px);
    property <length> content-height: root.height - root.content-y - 20px;

    TabBar {
        x: Preferences.menu-position == MenuPosition.right ? parent.width - 56px : 0px;
        y: 0px;
        width: Preferences.menu-position == MenuPosition.top ? parent.width : 56px;
        height: Preferences.menu-position == MenuPosition.top ? 24px : parent.height - 20px;
    }
    Rectangle {
        x: root.content-x; y: root.content-y;
        width: root.content-width; height: root.content-height;
        videos := VideoList {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            visible: (Nav.tab != HomeTab.mine && Nav.tab != HomeTab.settings) || (Nav.tab == HomeTab.mine && Nav.mine-detail);
        }
        if Nav.tab == HomeTab.mine && !Nav.mine-detail: MinePanel {
            width: parent.width; height: parent.height;
        }
        if Nav.tab == HomeTab.settings: SettingsPanel {
            width: parent.width; height: parent.height;
        }
        if videos.visible && videos.empty: EmptyState {
            width: parent.width; height: parent.height;
        }
    }

    // 按键说明弹窗
    if Nav.help: HelpOverlay { x: 16px; y: 20px; width: parent.width - 32px; height: parent.height - 42px; }
}
