// 登录页：二维码 + 状态提示 + 底部操作
import { Login } from "../state.slint";

export component LoginPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #0b0f17;

    Text { x: 0px; y: 6px; width: parent.width; text: "扫码登录 Bilibili"; color: #e6ebf5; font-size: 12px; horizontal-alignment: center; }
    if Login.has-qr: Image {
        x: (parent.width - 110px) / 2; y: 24px; width: 110px; height: 110px;
        source: Login.qr; image-fit: contain;
    }
    Text { x: 0px; y: parent.height - 34px; width: parent.width; text: Login.qr-status; color: #8b95a7; font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; horizontal-alignment: center; }
    Rectangle {
        x: 0px; y: parent.height - 20px; width: parent.width; height: 20px; background: #121a2a;
        Text { x: 22px; y: 0px; width: 54px; height: 20px; text: "刷新"; color: #7fb0ff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 248px; y: 0px; width: 54px; height: 20px; text: "返回"; color: #ffcf6e; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    }
}
