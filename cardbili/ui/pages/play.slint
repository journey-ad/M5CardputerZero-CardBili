// 播放页：画面 + 顶部标题栏 + 底部进度条
import { TripleAnimation } from "../components/triple_animation.slint";
import { PlaybackBar } from "../components/playback_bar.slint";
import { StatusBar } from "../components/status_bar.slint";
import { Icon, Icons } from "../components/icons.slint";
import { Player, Status, Danmaku, Preferences } from "../state.slint";

// 弹幕文字的字号与字间距
component DmGlyph inherits Text {
    font-family: "Fusion Pixel 12px Prop zh-Hans"; font-size: 12px; letter-spacing: -0.5px; height: 14px; vertical-alignment: center;
}

export component PlayPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000;

    if Player.has-frame: Image {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        source: Player.frame; image-fit: contain;
    }
    for row in Danmaku.rows: Rectangle {
        x: row.x; y: row.y; width: row.w; height: 14px;
        background: transparent;
        visible: Danmaku.enabled;
        opacity: Preferences.danmaku-opacity / 100;
        // 外部字体可用时，每条弹幕显示一张描边位图
        if Danmaku.baked: Image { x: 0px; y: 0px; source: row.img; }
        // 外部字体缺失时显示文字与半透明背景
        if !Danmaku.baked: Rectangle {
            x: 0px; y: 0px; width: row.w; height: 14px;
            background: #00000066; border-radius: 2px;
            DmGlyph { x: 2px; y: 0px; text: row.text; color: row.color; }
        }
    }
    if !Player.has-frame: Text {
        x: 0px; y: parent.height / 2 - 8px; width: parent.width;
        text: Status.status; color: #9aa6ba; font-size: 12px; horizontal-alignment: center;
    }

    // 暂停时在画面中央显示继续播放按钮
    if Player.paused && Player.triple-phase == 0: Rectangle {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: 32px; height: 32px; background: #00000070; border-radius: 16px;
        Icon { x: 4px; y: 4px; width: 24px; height: 24px; source: Icons.play; colorize: #ffffffee; }
        TouchArea { clicked => { Player.key("SPACE"); } }
    }

    Rectangle {
        visible: Player.controls-visible;
        x: 0px; y: 0px; width: parent.width; height: 20px; background: #000000cc;
        Rectangle {
            x: 0px; y: 0px; width: parent.width - 6px; height: 20px; clip: true;
            if Player.ptitle-marquee: Text {
                x: -Player.ptitle-shift; y: 0px; height: 20px; text: Player.ptitle; color: #e6ebf5;
                font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; vertical-alignment: center;
            }
            if !Player.ptitle-marquee: Text {
                x: 6px; y: 0px; width: parent.width - 6px; height: 20px; text: Player.ptitle; color: #e6ebf5;
                font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; vertical-alignment: center; overflow: elide;
            }
        }
    }

    PlaybackBar {
        visible: Player.controls-visible;
        x: 0px; y: parent.height - self.height; width: parent.width;
    }
    if Player.triple-phase > 0: TripleAnimation {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
    }
    StatusBar { x: (parent.width - self.width) / 2; y: parent.height - 50px; }
}
