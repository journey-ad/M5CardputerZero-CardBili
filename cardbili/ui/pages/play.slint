import { Text } from "../components/base/text.slint";
// 播放页：画面 + 顶部标题栏 + 底部进度条
import { TripleAnimation } from "../components/player/triple.slint";
import { PlaybackBar } from "../components/player/controls.slint";
import { SuperChatDialog } from "../components/live/superchat.slint";
import { Icon, Icons } from "../components/base/icons.slint";
import { Player, Status, Danmaku, Preferences, SuperChat, I18n, TrackMenu, MeterSample } from "../state.slint";
// 更多菜单里的单行按钮
component MenuEntry inherits Rectangle {
    in property <image> icon;
    in property <string> text: "";
    in property <string> state: "";
    in property <bool> selected: false;
    in property <bool> dropdown: false;
    in property <bool> cursor: false;
    callback clicked;
    height: 18px;
    background: cursor ? #33507a : (selected ? #24324a : (touch.has-hover ? #222d40 : transparent));
    Image {
        x: 6px; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
        source: root.icon;
        colorize: (root.selected || root.cursor) ? #ffffff : #aab8cc;
        image-fit: contain; image-rendering: pixelated;
    }
    Text {
        x: 26px; y: 0px; width: parent.width - (root.dropdown ? 114px : 46px); height: parent.height;
        text: root.text; color: root.selected ? #cfe0ff : #d7e0ee;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        vertical-alignment: center; overflow: elide;
    }
    if root.state != "": Text {
        x: parent.width - (root.dropdown ? 104px : 34px); y: 0px;
        width: root.dropdown ? 90px : 28px; height: parent.height;
        text: root.state; color: #8fa0b8;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide;
    }
    if root.dropdown: Image {
        x: parent.width - 16px; y: (parent.height - 10px) / 2; width: 10px; height: 10px;
        source: Icons.right; colorize: #7d8ea8; image-fit: contain; image-rendering: pixelated;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// 技术统计：左侧标签 + 右侧数值
component StatRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 14px;
    Text {
        x: 0px; y: 0px; width: 56px; height: 14px; text: root.label; color: #ffffff;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        horizontal-alignment: right; vertical-alignment: center;
    }
    Text {
        x: 60px; y: 0px; width: parent.width - 64px; height: 14px; text: root.value; color: #ffffff;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        horizontal-alignment: left; vertical-alignment: center; overflow: elide;
    }
}

// 技术统计：标签 + 历史柱状图 + 当前值
component StatMeter inherits Rectangle {
    in property <string> label;
    in property <[MeterSample]> samples;
    in property <string> value;
    height: 14px;
    Text {
        x: 0px; y: 0px; width: 56px; height: 14px; text: root.label; color: #ffffff;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        horizontal-alignment: right; vertical-alignment: center;
    }
    for meter[i] in root.samples : Rectangle {
        x: 60px + i * 1.28px; y: 0px; width: 1.3px; height: 12px; background: meter.base;
        if meter.fill > 0px : Rectangle {
            x: 0px; y: 12px - meter.fill; width: 1px; height: meter.fill; background: meter.top;
        }
    }
    Text {
        x: parent.width - 66px; y: 0px; width: 64px; height: 14px; text: root.value; color: #ffffff;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        horizontal-alignment: right; vertical-alignment: center; overflow: elide;
    }
}

export component PlayPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000;
    property <bool> show-controls: Player.controls-visible && !Player.stats-on;

    if Player.has-frame: Image {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        source: Player.frame; image-fit: contain;
    }
    // 正文、Mona 表情和黑色描边已合成为整条弹幕图片
    for row in Danmaku.rows: Image {
        x: round(row.x / 1px) * 1px; y: round(row.y / 1px) * 1px;
        width: row.img.width * 1px; height: row.img.height * 1px;
        source: row.img;
        image-rendering: pixelated;
        visible: Danmaku.enabled && !Player.stats-on;
        opacity: Preferences.danmaku-opacity / 100;
    }
    if !Player.has-frame: Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(parent.width - 32px, loading-text.preferred-width + root.loading-dots-width);
        height: max(16px, loading-text.preferred-height);
        loading-text := Text {
            width: parent.width - root.loading-dots-width; height: parent.height;
            text: Status.status; color: #9aa6ba; wrap: word-wrap;
            horizontal-alignment: center;
            font-size: 12px; vertical-alignment: center;
        }
        for index in 3: Rectangle {
            x: loading-text.width + 6px + index * 3px; y: parent.height / 2 + 3px;
            width: 1px; height: 1px; background: #9aa6ba;
            visible: index < Status.loading-dots;
        }
    }
    property <length> loading-dots-width: Status.loading-dots >= 0 ? 15px : 0px;
    property <length> audience-width: Player.live && Player.live-audience != "" ? audience.preferred-width + 21px : 0px;

    // 暂停时在画面中央显示继续播放按钮
    if Player.paused && Player.triple-phase == 0: Rectangle {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: 32px; height: 32px; background: #00000070; border-radius: 16px;
        Icon { x: 6px; y: 4px; width: 24px; height: 24px; source: Icons.play; colorize: #ffffffee; }
        TouchArea { clicked => { Player.key("SPACE"); } }
    }

    Rectangle {
        visible: root.show-controls;
        x: 0px; y: 0px; width: parent.width; height: 20px; background: #000000cc;
        Rectangle {
            x: 0px; y: 0px; width: Player.live ? parent.width - online.preferred-width - 26px - root.audience-width : parent.width - 6px; height: 20px; clip: true;
            if Player.ptitle-marquee: Text {
                x: -Player.ptitle-shift; y: 0px; height: 20px; text: Player.ptitle; color: #e6ebf5;
                font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; vertical-alignment: center;
            }
            if !Player.ptitle-marquee: Text {
                x: 6px; y: 0px; width: parent.width - 6px; height: 20px; text: Player.ptitle; color: #e6ebf5;
                font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px; vertical-alignment: center; overflow: elide;
            }
        }
    }

    title-measure := Text {
        visible: false; text: Player.ptitle;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
    }
    online := Text {
        x: root.width - self.preferred-width - 6px; y: 0px; height: 20px;
        text: Player.watching; color: #9aa6ba;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        vertical-alignment: center;
        visible: root.show-controls && (Player.live || title-measure.preferred-width + self.preferred-width + 18px <= root.width);
    }
    if Player.live && root.show-controls && Player.watching != "": Icon {
        x: online.x - 15px; y: 4px;
        source: Icons.hot; colorize: #9aa6ba;
    }
    audience := Text {
        x: online.x - 21px - self.preferred-width; y: 0px; height: 20px;
        text: Player.live-audience; color: #9aa6ba;
        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        vertical-alignment: center;
        visible: Player.live && root.show-controls && Player.live-audience != "";
    }
    if Player.live && root.show-controls && Player.live-audience != "": Icon {
        x: audience.x - 15px; y: 4px;
        source: Icons.eye-minimal; colorize: #9aa6ba;
    }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: 20px; enabled: root.show-controls; clicked => { Player.key(Player.live ? "SPACE" : "p"); } }

    PlaybackBar {
        visible: root.show-controls;
        x: 0px; y: parent.height - self.height; width: parent.width;
    }
    if Player.reconnect-text != "": Rectangle {
        x: 6px; y: parent.height - 50px;
        width: parent.width - 12px; height: 18px;
        background: #1c2434e6; border-radius: 3px;
        Text {
            width: parent.width; height: parent.height;
            text: Player.reconnect-text; color: #cdd4e0;
            font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    // 字幕层：位于画面底部、控制条上方
    if Player.subtitle-selected > 0 && Player.subtitle-text != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - (root.show-controls ? 30px : 8px);
        width: min(parent.width * 0.95, subtitle-line.preferred-width + 12px);
        height: min(parent.height - 52px, subtitle-line.preferred-height + 6px);
        background: #000000cc; border-radius: 3px;
        subtitle-line := Text {
            x: 6px; y: 3px; width: parent.width - 12px; height: parent.height - 6px;
            text: Player.subtitle-text; color: #ffffff; wrap: word-wrap;
            horizontal-alignment: center; vertical-alignment: center;
            font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
        }
    }
    // 技术统计半透明蒙层
    if Player.stats-on: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000099;
        VerticalLayout {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            alignment: start;
            for line in Player.stat-head: StatRow { label: line.label; value: line.value; }
            if Player.connection-value != "": StatMeter { label: "Speed"; samples: Player.connection-samples; value: Player.connection-value; }
            if Player.buffer-value != "": StatMeter { label: "Buffer"; samples: Player.buffer-samples; value: Player.buffer-value; }
            for line in Player.stat-tail: StatRow { label: line.label; value: line.value; }
        }
    }
    // 更多菜单浮层
    if Player.menu-open: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000066;
        TouchArea { clicked => { Player.key("menu:close"); } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 220px;
            height: (Player.track-menu != TrackMenu.closed ? Player.track-labels.length * 18px : (Player.live ? 18px : 72px)) + 38px;
            background: #1c2434; border-radius: 4px; border-width: 1px; border-color: #47566e;
            if Player.track-menu == TrackMenu.closed: VerticalLayout {
                padding: 4px; spacing: 0px;
                Rectangle {
                    height: 16px;
                    Text {
                        x: 6px; y: 0px; width: parent.width - 12px; height: parent.height;
                        text: I18n.tr("更多功能"); color: #7d8ea8;
                        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                if !Player.live: MenuEntry { icon: Icons.comment-text; text: I18n.tr("查看评论"); cursor: Player.menu-index == 0; clicked => { Player.key("menu:comments"); } }
                if !Player.live: MenuEntry {
                    icon: Icons.captions;
                    text: I18n.tr("字幕");
                    state: Player.subtitle-selected > 0 ? Player.subtitle-labels[Player.subtitle-selected] : I18n.tr("关闭");
                    dropdown: true;
                    cursor: Player.menu-index == 1;
                    clicked => { Player.key("menu:subtitle"); }
                }
                if !Player.live: MenuEntry {
                    icon: Icons.music;
                    text: I18n.tr("音轨");
                    state: Player.audio-labels.length > 0 && Player.audio-selected >= 0 ? Player.audio-labels[Player.audio-selected] : "";
                    dropdown: true;
                    cursor: Player.menu-index == 2;
                    clicked => { Player.key("menu:audio"); }
                }
                MenuEntry { icon: Icons.chart; text: I18n.tr("统计信息"); cursor: Player.menu-index == (Player.live ? 0 : 3); clicked => { Player.key("menu:stats"); } }
                Rectangle {
                    height: 14px;
                    Text {
                        x: 6px; y: 0px; width: parent.width - 12px; height: parent.height;
                        text: I18n.tr("↑↓ 选择  Enter 展开  Esc 关闭"); color: #66788f;
                        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }
            if Player.track-menu != TrackMenu.closed: VerticalLayout {
                padding: 4px; spacing: 0px;
                Rectangle {
                    height: 16px;
                    Text {
                        x: 6px; y: 0px; width: parent.width - 12px; height: parent.height;
                        text: Player.track-menu == TrackMenu.subtitle ? I18n.tr("字幕") : I18n.tr("音轨");
                        color: #7d8ea8;
                        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                for label[index] in Player.track-labels: MenuEntry {
                    icon: Player.track-menu == TrackMenu.subtitle ? Icons.captions : Icons.music;
                    text: label;
                    selected: (Player.track-menu == TrackMenu.subtitle ? Player.subtitle-selected : Player.audio-selected) == index;
                    cursor: Player.menu-sub-index == index;
                    clicked => { Player.key((Player.track-menu == TrackMenu.subtitle ? "sub:" : "audio:") + index); }
                }
                Rectangle {
                    height: 14px;
                    Text {
                        x: 6px; y: 0px; width: parent.width - 12px; height: parent.height;
                        text: I18n.tr("↑↓ 选择  Enter 确认  Esc 返回"); color: #66788f;
                        font-family: "Fusion Pixel 10px Prop zh-Hans"; font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    if Player.triple-phase > 0: TripleAnimation {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2 - 10px;
    }
    if Player.live && SuperChat.open: SuperChatDialog {}
}
