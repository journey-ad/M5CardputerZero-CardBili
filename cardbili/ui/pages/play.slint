// 播放页：画面 + 顶部标题栏 + 底部进度条
import { Player, Status } from "../state.slint";

export component PlayPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000;

    if Player.has-frame: Image {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        source: Player.frame; image-fit: contain;
    }
    if !Player.has-frame: Text {
        x: 0px; y: parent.height / 2 - 8px; width: parent.width;
        text: Status.status; color: #9aa6ba; font-size: 12px; horizontal-alignment: center;
    }

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 20px; background: #000000cc;
        Rectangle {
            x: 0px; y: 0px; width: parent.width - 44px; height: 20px; clip: true;
            if Player.ptitle-marquee: Text {
                x: -Player.ptitle-shift; y: 0px; height: 20px; text: Player.ptitle; color: #e6ebf5;
                font-size: 10px; vertical-alignment: center;
            }
            if !Player.ptitle-marquee: Text {
                x: 6px; y: 0px; width: parent.width - 6px; height: 20px; text: Player.ptitle; color: #e6ebf5;
                font-size: 10px; vertical-alignment: center; overflow: elide;
            }
        }
        Text { x: parent.width - 36px; y: 0px; width: 30px; height: 20px; text: Player.paused ? "❚❚" : "▶"; color: #6ea8ff; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
    }

    Rectangle {
        x: 0px; y: parent.height - 26px; width: parent.width; height: 26px; background: #000000b0;
        Rectangle { x: 6px; y: 3px; width: parent.width - 12px; height: 4px; background: #2a3346; border-radius: 2px; }
        Rectangle { x: 6px; y: 3px; width: (parent.width - 12px) * Player.progress; height: 4px; background: #6ea8ff; border-radius: 2px; }
        Text { x: 6px; y: 9px; text: Player.time-text; color: #cfd8e6; font-size: 9px; }
        Text { x: parent.width - 130px; y: 9px; width: 124px; text: Player.play-state; color: #8b95a7; font-size: 9px; horizontal-alignment: right; }
    }
}
