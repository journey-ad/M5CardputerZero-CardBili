import { Uploader } from "../state.slint";
import { VideoList } from "../components/video_list.slint";

export component UploaderPage inherits Rectangle {
    width: 100%; height: 100%; background: #0b0f17;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 24px; background: #121a2a;
        Text {
            x: 8px; width: parent.width - 16px; height: parent.height;
            text: Uploader.name + "的作品"; color: #7fb0ff; font-size: 12px;
            vertical-alignment: center; overflow: elide;
        }
    }
    videos := VideoList {
        x: 0px; y: 24px; width: parent.width; height: parent.height - 44px;
        show-author: false;
    }
    if videos.empty: Text {
        x: 8px; y: 60px; width: parent.width - 16px; height: 60px;
        text: Uploader.loading ? "加载中…" : (Uploader.error != "" ? Uploader.error : "暂无作品");
        color: #9aa6ba; font-size: 12px; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
