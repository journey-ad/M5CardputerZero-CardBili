import { HomeTab, Page, VideoLayout, MenuPosition } from "types.slint";
// 页面与组件共用的全局状态
import { Cmt, DmRow, VideoRow, FavoriteRow, FollowingRow, HistoryHeader, SuperChatRow } from "common.slint";

// 界面语言：lang 为 0 时显示中文原文，否则由 Rust 按 i18n/*.po 查表
// tr 读取 lang，切换语言时所有文案绑定随之刷新
export global I18n {
    in-out property <int> lang: 0;
    pure callback lookup(string) -> string;
    public pure function tr(text: string) -> string {
        return self.lang == 0 ? text : self.lookup(text);
    }
}

// 导航与交互态
export global Nav {
    in-out property <Page> page: Page.home;
    in-out property <HomeTab> tab: HomeTab.recommended;
    in-out property <int> sel: 0;
    in-out property <VideoLayout> view: VideoLayout.list;
    in-out property <bool> help: false;
    in-out property <bool> mine-detail: false;
}

// 页面可视区域由窗口、页头、侧栏和底栏共同确定
export global Layout {
    in-out property <length> window-width: 320px;
    in-out property <length> window-height: 170px;
    out property <length> bottom-bar-height: 20px;
    out property <length> sidebar-width: Nav.page == Page.home && Preferences.menu-position != MenuPosition.top ? 56px : 0px;
    out property <length> video-x: Preferences.menu-position == MenuPosition.left ? self.sidebar-width : 0px;
    out property <length> video-y: Nav.page == Page.collection ? 30px : (Preferences.menu-position == MenuPosition.top ? 24px : 0px);
    out property <length> video-width: self.window-width - self.sidebar-width;
    out property <length> video-height: self.window-height - self.video-y - self.bottom-bar-height;
}

// 列表数据与状态
export global ListModel {
    in-out property <[VideoRow]> rows: [];
    in-out property <[HistoryHeader]> headers: [];
    in-out property <length> header-height: 30px;
    in-out property <[float]> row-tops: [];
    in-out property <float> scroll-y: 0;
    in-out property <float> content-height: 0;
    in-out property <length> row-height: 30px;
    in-out property <length> grid-offset: 0px;
    in-out property <string> history-count: "";
    in-out property <string> favorite-count: "";
    in-out property <bool> loading: false;
    in-out property <int> cols: 3;
    in-out property <length> cell-w: 106px;
    in-out property <length> cell-h: 84px;
    in-out property <[image]> grid-covers: [];
    in-out property <[VideoRow]> grid-rows: [];
    in-out property <[int]> grid-columns: [];
    in-out property <[float]> grid-tops: [];
    in-out property <int> grid-active: -1;
    in-out property <bool> title-marquee: false;
    in-out property <length> title-shift: 0px;
}

// 直播分区：目录、选择位置与加载状态
export global LiveAreas {
    callback key(string);
    in-out property <bool> open: false;
    in-out property <bool> loading: false;
    in-out property <string> error: "";
    in-out property <string> title: I18n.tr("选择直播分区");
    in-out property <[string]> rows: [];
    in-out property <int> selected: 0;
}

// 通用状态文本：首页状态栏、空状态、播放占位共用
export global Status {
    in-out property <string> status: "";
    in-out property <int> loading-dots: -1;
    in-out property <string> detail: "";
    in-out property <string> bar: "";
    in-out property <bool> bar-sticky: false;
}

// 账号
export global Account {
    in-out property <bool> logged: false;
    in-out property <bool> known: false;
    in-out property <string> name: "";
    in-out property <string> mid: "";
    in-out property <string> level: "";
    in-out property <string> vip: "";
    in-out property <image> avatar;
    in-out property <bool> has-avatar: false;
}

// 播放
export global Player {
    callback key(string);
    in-out property <bool> liked: false;
    in-out property <bool> reaction-busy: false;
    // 0 隐藏，1 长按，2 请求中，3 已完成
    in-out property <int> triple-phase: 0;
    in-out property <int> triple-charge: 0;
    in-out property <int> triple-tick: 0;
    in-out property <string> speed-text: "1X";
    in-out property <image> frame;
    in-out property <bool> has-frame: false;
    in-out property <string> reconnect-text: "";
    in-out property <string> ptitle: "";
    in-out property <string> watching: "";
    in-out property <string> live-audience: "";
    in-out property <bool> ptitle-marquee: false;
    in-out property <length> ptitle-shift: 0px;
    in-out property <float> progress: 0.0;
    in-out property <string> time-text: "00:00 / 00:00";
    in-out property <bool> paused: false;
    in-out property <bool> finished: false;
    in-out property <bool> controls-visible: true;
    in-out property <bool> live: false;
}

// 弹幕：Rust 每帧写入当前可见弹幕
export global Danmaku {
    in-out property <bool> enabled: true;
    in-out property <[DmRow]> rows: [];
}

// 直播醒目留言：入口、弹窗列表、倒计时与滚动位置
export global SuperChat {
    in-out property <bool> available: false;
    in-out property <bool> open: false;
    in-out property <[SuperChatRow]> rows: [];
    in-out property <int> elapsed: 0;
    in-out property <length> scroll: 0px;
    in-out property <length> content-h: 0px;
    in-out property <length> viewport-h: 0px;
}

// 应用设置
export global Preferences {
    in-out property <bool> danmaku-default: true;
    in-out property <bool> record-history: true;
    in-out property <bool> debug-log: false;
    in-out property <bool> color-emoji: true;
    in-out property <bool> pixel-optimize: false;
    in-out property <string> scale-algorithm-name: "";
    in-out property <string> cdn-name: "";
    in-out property <string> cache-size: I18n.tr("统计中…");
    in-out property <bool> cache-busy: false;
    in-out property <int> danmaku-opacity: 90;
    in-out property <MenuPosition> menu-position: MenuPosition.top;
}

// 详情
export global Detail {
    in-out property <length> title-shift: 0px;
    in-out property <bool> loading: false;
    in-out property <string> error: "";
    in-out property <string> title: "";
    in-out property <string> bvid: "";
    in-out property <[string]> metrics: [];
    in-out property <string> desc: "";
    in-out property <string> owner: "";
    in-out property <image> cover;
    in-out property <bool> has-cover: false;
    in-out property <length> scroll: 0px;
    in-out property <length> thumb-h: 0px;
    in-out property <length> thumb-y: 0px;
    in-out property <length> content-h: 0px;
    in-out property <length> viewport-h: 0px;
    in-out property <length> title-width: 0px;
    in-out property <length> title-text-width: 0px;
}

// 登录
export global Login {
    in-out property <image> qr;
    in-out property <bool> has-qr: false;
    in-out property <string> qr-status: "";
}

// 静态文案
export global Meta {
    in-out property <string> about-text: "";
    in-out property <length> about-content-h: 0px;
    // 页签每格约 53px（含图标），英文需要专门的短词，因此不走通用译文
    in-out property <[string]> tab-names: I18n.lang == 0
        ? ["推荐", "热门", "动态", "直播", "我的", "设置"]
        : ["Home", "Hot", "Feed", "Live", "Me", "Prefs"];
    // 页签统一标签宽度
    in-out property <length> tab-label-max-width: 0px;
    in-out property <string> version: "";
    in-out property <length> about-scroll: 0px;
}

export global Collection {
    in-out property <string> title;
    in-out property <string> empty;
    in-out property <bool> is-author: false;
    in-out property <string> name: "";
    in-out property <string> uid: "";
    in-out property <string> level: "";
    in-out property <string> followers: "";
    in-out property <image> avatar;
    in-out property <bool> has-avatar: false;
    in-out property <bool> loading: false;
    in-out property <string> error: "";
}

export global Menu {
    in-out property <[string]> labels: [];
}

// 收藏夹列表
export global Favorite {
    in-out property <[FavoriteRow]> folders: [];
    in-out property <int> selected: 0;
    in-out property <bool> loading: false;
    in-out property <string> error: "";
}

// 关注动态列表
export global Following {
    in-out property <[FollowingRow]> rows: [];
    in-out property <int> selected: 0;
    in-out property <bool> loading: false;
    in-out property <string> error: "";
}

// 通用确认弹窗
export global Confirm {
    in-out property <bool> open: false;
    in-out property <string> title: "";
    in-out property <string> message: "";
    in-out property <string> label: "";
    in-out property <bool> selected: false;
    callback result(bool);
}

// CDN 线路选择面板
export global Cdn {
    in-out property <bool> open: false;
    in-out property <bool> testing: false;
    in-out property <int> current: 1;
    in-out property <int> selected: 1;
    in-out property <int> first: 0;
    in-out property <[Cmt]> rows: [];
}

// 分P选择面板
export global Sections {
    in-out property <bool> open: false;
    in-out property <[Cmt]> rows: [];
    in-out property <int> selected: 0;
    in-out property <bool> loading: false;
    in-out property <string> error: "";
}
